<?xml version="1.0" encoding="utf-8"?>
<!-- Debug-only: allow cleartext to the local test server (10.0.2.2) for
     Phase 2 resource downloads. Release builds keep the main config. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">habous.gov.ma</domain>
        <trust-anchors>
            <certificates src="@raw/habous_ca"/>
            <certificates src="system"/>
        </trust-anchors>
    </domain-config>
</network-security-config>
